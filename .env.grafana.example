# Copy to .env and fill in real values (.env is gitignored, never commit the real file).
# Find these under Grafana Cloud -> your stack -> Connections -> Hosted Prometheus metrics.
GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-XX-prod-xx-x.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=your-instance-id
GRAFANA_CLOUD_PROMETHEUS_API_KEY=your-api-key
